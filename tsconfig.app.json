{
  "extends": ["@vue/tsconfig/tsconfig.dom.json", "./tsconfig.strict.json"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "entry/**/*.ts", "env.d.ts"],
  "exclude": ["src/**/*.test.ts", "src/test/**", "entry/**/*.test.ts"],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "fallthroughAttributes": true
  }
}
