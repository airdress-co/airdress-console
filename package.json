{
  "name": "airdress-console",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Airdress operator console: a static web app that connects to your own operator.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.entry.config.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.ts",
    "check:doc-numbers": "sh scripts/check-doc-numbers.sh",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run check:bundle && npm run check:doc-numbers && npm run check:api",
    "gen:api": "npx --yes openapi-typescript@7.13.0 api/operator-openapi.yaml -o src/api/generated/operator.d.ts",
    "check:api": "sh scripts/check-api.sh"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.105.2",
    "vue": "3.5.44",
    "vue-i18n": "11.4.17",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@tanstack/vue-query-devtools": "6.3.8",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
